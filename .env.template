# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# --- Onshape API keys -------------------------------------------------------
# Generate a key pair inside Onshape itself:
#   Personal account:  user icon -> My account -> Developer
#   Enterprise / FRC:  user icon -> Enterprise settings -> Developer -> API keys
#                      (admin only; the key is assigned to a named member)
# Scope: OAuth2Read plus OAuth2Write — the FeatureScript check writes a module
# to a scratch Feature Studio and restores it. Never grant Delete: removing a
# feature is a write, so the copilot never needs it, and Delete's blast radius
# is whole documents and workspaces.
# The secret is shown exactly once; if you lose it, generate a new pair.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# --- Account ----------------------------------------------------------------
# Standard accounts:            https://cad.onshape.com
# Enterprise / FRC accounts:    https://<company>.onshape.com
ONSHAPE_BASE_URL=https://cad.onshape.com

# Onshape versions every endpoint. Probed live on 2026-08-03: v0-v26 all return
# 200, v27 returns 400. A stale version never errors — it just quietly serves an
# older contract — so "it works" is no evidence you are on the right one.
# Onshape's guidance is to always call the newest. Re-probe before bumping.
ONSHAPE_API_VERSION=v26

# --- Tuning -----------------------------------------------------------------
# Default read timeout. Slow endpoints override it individually in
# src/api/onshape_client.py — assembly mass properties genuinely takes ~41 s on
# a real robot, which is why a flat 30 s made it look broken.
ONSHAPE_TIMEOUT_SECONDS=30

# Retries for 429s, 5xx and connection failures. Read timeouts are never
# retried: a timed-out request still spends its quota slot (measured), so the
# server has it and a retry would pay twice for work already running.
ONSHAPE_MAX_RETRIES=3

# Stop calling an endpoint when this many requests remain in its bucket, so a
# retry storm cannot spend the last of a shared budget. Onshape meters each
# endpoint separately and the ceilings differ by 30x: the FeatureScript
# evaluate endpoint is about 84 where document reads are 3000.
FRC_QUOTA_FLOOR=5

# Documents the copilot is allowed to write to. Comma-separated. Never point
# this at a team's robot document.
# FRC_SCRATCH_DOCUMENT_IDS=

# --- Not required -----------------------------------------------------------
# Claude Code is the AI core and authenticates itself; nothing in this Python
# process calls the Anthropic API. Left commented so the server never refuses
# to start over a credential it does not use.
# ANTHROPIC_API_KEY=
