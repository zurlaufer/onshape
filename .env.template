# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# --- Onshape API keys -------------------------------------------------------
# Generate a key pair inside Onshape itself:
#   Personal account:  user icon -> My account -> Developer
#   Enterprise / FRC:  user icon -> Enterprise settings -> Developer -> API keys
#                      (admin only; the key is assigned to a named member)
# Scope: OAuth2Read is enough through Step 3. Add OAuth2Write only when the
# FeatureScript compiler loop starts pushing code back. Never grant Delete.
# The secret is shown exactly once; if you lose it, generate a new pair.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# --- Account ----------------------------------------------------------------
# Standard accounts:            https://cad.onshape.com
# Enterprise / FRC accounts:    https://<company>.onshape.com
ONSHAPE_BASE_URL=https://cad.onshape.com

# Onshape versions every endpoint. Probed live on 2026-08-03: v0-v26 all return
# 200, v27 returns 400. A stale version never errors — it just quietly serves an
# older contract — so "it works" is no evidence you are on the right one.
# Onshape's guidance is to always call the newest. Re-probe before bumping.
ONSHAPE_API_VERSION=v26

# --- Tuning -----------------------------------------------------------------
ONSHAPE_TIMEOUT_SECONDS=30

# --- Not required -----------------------------------------------------------
# Claude Code is the AI core and authenticates itself; nothing in this Python
# process calls the Anthropic API. Left commented so the server never refuses
# to start over a credential it does not use.
# ANTHROPIC_API_KEY=
